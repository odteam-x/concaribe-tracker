# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo server-side / Edge Functions, nunca en el cliente

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=      # key publica restringida por HTTP referrer (Maps JavaScript API)
GOOGLE_MAPS_SERVER_API_KEY=           # key privada, sin restriccion de referrer (Geocoding + Directions)

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # solo Edge Functions
VAPID_SUBJECT=mailto:soporte@concaribe.com
