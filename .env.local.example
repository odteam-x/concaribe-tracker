# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # solo server-side / Edge Functions, nunca en el cliente

# Mapas: OpenStreetMap (Leaflet) + Nominatim (geocoding) + OSRM (rutas/optimización).
# No requieren API key ni tarjeta — no hay variables de entorno que configurar aquí.

# Web Push (VAPID) — generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # solo Edge Functions
VAPID_SUBJECT=mailto:soporte@concaribe.com
